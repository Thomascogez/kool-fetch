{
  "name": "kool-fetch",
  "version": "0.6.0",
  "type": "module",
  "author": {
    "email": "thomas.cogez@gmail.com",
    "name": "Thomas Cogez",
    "url": "https://thomas-cogez.fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thomascogez/kool-fetch"
  },
  "description": "A 0-dependency fetch wrapper bringing axios like request and response interceptors",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "generate-types": "tsc --emitDeclarationOnly src/index.ts --outDir ./dist",
    "test:watch": "vitest",
    "test:single": "vitest run",
    "test:types": "vitest run --typecheck",
    "checks": "npm-run-all --parallel checks:*",
    "checks:types": "tsc --noEmit",
    "checks:biome": "biome check",
    "checks:knip": "knip",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@changesets/cli": "^2.30.0",
    "knip": "^5.86.0",
    "msw": "^2.12.10",
    "npm-run-all": "^4.1.5",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "undici": "^8.10.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "undici": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
